# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Replace this value with that random secret (at least 32 characters).
# Use the same secret in the PC relay settings. Never commit .env.
RELAY_TOKEN=
# Public HTTPS origin served by your reverse proxy; relay itself uses HTTP.
RELAY_PUBLIC_URL=https://super.tkcloud.online:444
# Match the bind-mounted directory owner when it is private (e.g. mode 700).
# On the server: stat -c '%u:%g' .
RELAY_UID=10001
RELAY_GID=10001
